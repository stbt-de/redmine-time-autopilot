<%# Arbeitszeit je Wochentag in „Mein Konto“ bzw. in der Benutzerverwaltung
    (Hook view_my_account_preferences / view_users_form_preferences) %>
<% person = user %>
<% if person&.persisted? && RedmineTimeAutopilot::WorkSchedule.editable?(User.current, person) %>
  <% hours = RedmineTimeAutopilot::WorkSchedule.new(person).hours || {} %>
  <p id="ta-work-hours" class="ta-work-hours-row">
    <label><%= l(:label_time_autopilot_work_hours) %></label>
    <span class="ta-work-hours-days">
      <% (1..7).each do |cwday| %>
        <label>
          <span><%= ::I18n.t('date.abbr_day_names')[cwday % 7] %></span>
          <%= number_field_tag "work_hours[#{cwday}]", (hours[cwday].to_f.positive? ? format('%g', hours[cwday].round(2)) : ''),
                               id: nil, min: 0, max: 24, step: 0.25, placeholder: '0' %>
        </label>
      <% end %>
    </span>
    <em class="info"><%= l(:text_time_autopilot_work_hours_info) %></em>
  </p>
  <style>
    .ta-work-hours-days { display: inline-flex; flex-wrap: wrap; gap: 6px; vertical-align: top; }
    .ta-work-hours-days label { display: flex; flex-direction: column; align-items: center; gap: 2px; float: none; width: auto; margin: 0; padding: 0; font-weight: 400; text-align: center; }
    .ta-work-hours-days input { width: 3.6em; text-align: right; }
  </style>
<% end %>
