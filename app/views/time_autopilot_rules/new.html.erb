<% html_title l(:button_time_autopilot_new_rule) %>
<%= render 'time_autopilot/tabs', current: :rules %>
<h2><%= l(:button_time_autopilot_new_rule) %></h2>
<%= form_for @rule, as: :rule, url: time_autopilot_rules_path, method: :post do |f| %>
  <%= render 'form', f: f %>
  <p><%= submit_tag l(:button_create) %> <%= link_to l(:button_cancel), time_autopilot_rules_path %></p>
<% end %>
