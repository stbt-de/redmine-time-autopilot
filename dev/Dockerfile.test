# Redmine mit Test-Gems für die Plugin-Tests (dev/run-tests.sh).
# Das offizielle Image installiert ohne die Gruppen development und test.
# Mit MCP_PLUGIN_REF zusätzlich redmine_mcp_plugin in diesem Stand – für die
# Tests der MCP-Werkzeuge (braucht Redmine 6.1 oder neuer).
ARG REDMINE_VERSION=7.0
FROM redmine:${REDMINE_VERSION}
ARG MCP_PLUGIN_REF=

WORKDIR /usr/src/redmine

# Compiler für Gems mit nativen Erweiterungen (ältere Images haben keinen), git für das MCP-Plugin
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git \
 && rm -rf /var/lib/apt/lists/*

RUN if [ -n "$MCP_PLUGIN_REF" ]; then \
      git clone --quiet https://github.com/joaoperfig/redmine_mcp_plugin.git plugins/redmine_mcp_plugin \
      && git -C plugins/redmine_mcp_plugin checkout --quiet "$MCP_PLUGIN_REF"; \
    fi

RUN printf 'test:\n  adapter: sqlite3\n  database: db/test.sqlite3\n' > config/database.yml \
 && bundle config set --local without development \
 && bundle install --quiet \
 && RAILS_ENV=test bin/rails db:create db:migrate \
 && if [ -n "$MCP_PLUGIN_REF" ]; then RAILS_ENV=test bin/rails redmine:plugins:migrate NAME=redmine_mcp_plugin; fi
